# Copy to .env and fill in to enable real LLM-backed checks. The app runs
# fully offline with the mock engine (no API key required) if you leave
# these unset.

ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Uncomment to seed jurisdictions + demo data automatically on server start
# (used in production; not needed for local dev, where you run the seed
# scripts directly - see README.md).
# AUTO_SEED_ON_START=1

# Defaults to local SQLite (./permitting.db) if unset.
# DATABASE_URL=
